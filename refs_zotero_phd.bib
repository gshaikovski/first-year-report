  langid = {english},
  keywords = {Computer Science - Computation and Language,Computer Science - Computational Complexity,Computer Science - Machine Learning,Statistics - Machine Learning},
  file = {/Users/george/Zotero/storage/RFUG7L2B/Feng et al. - 2023 - Towards Revealing the Mystery behind Chain of Thought A Theoretical Perspective.pdf}
