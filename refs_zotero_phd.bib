@misc{shenUnderstandingReasoningPretraining2026,
  title = {Understanding {{Reasoning}} from {{Pretraining}} to {{Post-Training}}},
  author = {Shen, Jingyan and Li, Ang and Rahman, Salman and Sun, Yifan and Goldblum, Micah and Telgarsky, Matus and Izmailov, Pavel},
  year = 2026,
  month = aug,
  number = {arXiv:2607.16097},
  eprint = {2607.16097},
