  langid = {english},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Machine Learning},
  file = {/Users/george/Zotero/storage/W96RKX5A/Shojaee et al. - 2025 - The Illusion of Thinking Understanding the Strengths and Limitations of Reasoning Models via the Le.pdf}
}

